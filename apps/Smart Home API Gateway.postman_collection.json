	"item": [
		{
			"name": "Devices",
			"item": [
				{
					"name": "1. Create Device",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// генерируем UUID (v4)\r",
									"function uuidv4() {\r",
									"    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {\r",
									"        let r = Math.random() * 16 | 0, v = c === 'x' ? r : (r & 0x3 | 0x8);\r",
									"        return v.toString(16);\r",
									"    });\r",
									"}\r",
									"\r",
									"let newDeviceKey = uuidv4();\r",
									"let newHomeId = uuidv4();\r",
									"let newOwnerAccount = uuidv4();\r",
									"\r",
									"// сохраняем в переменную коллекции\r",
									"pm.collectionVariables.set(\"deviceKey\", newDeviceKey);\r",
									"pm.collectionVariables.set(\"newHomeId\", newHomeId);\r",
									"pm.collectionVariables.set(\"newOwnerAccount\", newOwnerAccount);\r",
									"\r",
									"// для отладки\r",
									"console.log(\"Generated deviceKey:\", newDeviceKey);\r",
									"console.log(\"Generated homeId:\", newHomeId);\r",
									"console.log(\"Generated ownerAccount:\", newOwnerAccount);\r",
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"let response = pm.response.json();\r",
									"\r",
									"// сохраняем значение \"id\" в переменную коллекции\r",
									"pm.collectionVariables.set(\"device_id\", response.id);\r",
									"\r",
									"// для проверки сразу выведем в консоль\r",
									"console.log(\"Created Device ID:\", response.id);\r",
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"deviceKey\": \"{{deviceKey}}\",\n  \"typeCode\": \"termostat\",\n  \"model\": \"termostat-super-bot\",\n  \"location\": \"Living Room\", \n  \"homeId\": \"{{newHomeId}}\",\n  \"ownerAccount\": \"{{newOwnerAccount}}\",\n  \"metadata\": {\n    \"brand\": \"LG\"\n  }\n}"
						},
						"url": {
							"raw": "http://localhost:8080/api/v1/devices",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8080",
							"path": [
								"api",
								"v1",
								"devices"
							]
						},
						"description": "Добавление нового устройства"
					},
					"response": []
				},
