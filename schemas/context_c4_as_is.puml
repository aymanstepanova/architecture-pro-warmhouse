@startuml
!include C4_Context.puml
LAYOUT_WITH_LEGEND()

title C4: Диаграмма контекста — «Тёплый дом» (AS IS)

Person(user, "Пользователь", "Владелец дома: включает/выключает отопление и просматривает текущую температуру через веб-интерфейс.")
Person(installer, "Специалист по установке", "Выезжает на объект, подключает и регистрирует датчики в системе. Пользователь сам подключиться не может.")

Enterprise_Boundary(warmhouse, "Компания «Тёплый дом»") {
    System(monolith, "Система управления отоплением",  "Монолитный веб-сервис. Управление отоплением и просмотр температуры.")
}

System_Ext(sensors, "Датчики температуры и контроллер отопления в доме",    "Домашние устройства. Не инициируют связь. Получают команды управления и отвечают на запросы измерений.")

Rel(user, monolith, "Управление отоплением и запросы на просмотр температуры", "HTTPS (sync)")
Rel(monolith, user, "Данные о состоянии отопления и текущей температуре", "HTML/JSON")

Rel_R(installer, monolith, "Подключение/регистрация датчиков, настройка", "HTTPS (sync)")
Rel_Neighbor(monolith, sensors, "Команды управления отоплением (on/off)", "HTTPS (sync)")
Rel_R(monolith, sensors, "Запрос текущей температуры (polling)", "HTTPS (sync)")

@enduml
